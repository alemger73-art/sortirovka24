# Keep the Docker build context small and reproducible.
# MUST keep for SPA build: app/frontend/{src,public,index.html,package.json,
# pnpm-lock.yaml,.npmrc,vite.config.*,tsconfig*,tailwind*,postcss*,assets}.

# Accidental nested path (not used)
app/app

# Node (rebuilt inside the image)
**/node_modules
**/dist
**/.vite
**/*.tsbuildinfo

# Mobile / store artifacts not needed for the web image
app/frontend/android
app/frontend/ios
app/frontend/releases
**/*.aab
**/*.apk
**/*.keystore
app/frontend/.android-sdk

# Python caches / local artifacts
**/__pycache__
**/*.pyc
**/.pytest_cache
**/*.db
**/dev.db

# Backend runtime/local-only files
app/backend/logs
app/backend/.jwt_secret
app/backend/.env
app/backend/frontend_dist

# Repo meta
.git
.idea
.vscode
uploads
**/*.log
