# Keep the Docker build context small and reproducible.

# Frontend source IS needed: the backend image builds it and serves the SPA.
# We still exclude its node_modules/dist below so the context stays small.
app/app

# Node
**/node_modules
**/dist
**/.vite
**/*.tsbuildinfo

# Python caches / local artifacts
**/__pycache__
**/*.pyc
**/.pytest_cache
**/*.db
**/dev.db

# Backend runtime/local-only files
app/backend/logs
app/backend/.jwt_secret
app/backend/.env

# Repo meta
.git
.idea
.vscode
uploads
**/*.log
