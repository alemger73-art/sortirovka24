# Sortirovka24 staging contract. Copy names to Railway; never commit values.
ENVIRONMENT=staging
DEBUG=false
SMS_EXPOSE_CODE=true
ENTITY_WRITE_PROTECTION=on
MGX_IGNORE_INIT_DATA=true

# A new PostgreSQL service dedicated to staging.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@STAGING_DB_HOST:PORT/railway
STAGING_DATABASE_HOST=STAGING_DB_HOST

# The generated Railway staging domain or stage.sortirovka24.kz.
STAGING_BASE_URL=https://STAGING_HOST
PUBLIC_FRONTEND_URL=https://STAGING_HOST
CORS_ALLOWED_ORIGINS=https://STAGING_HOST

# Unique staging-only secrets. Do not copy the production values.
JWT_SECRET_KEY=GENERATE_A_NEW_STAGING_SECRET
FOOD_SECRETS_KEY=GENERATE_A_NEW_STAGING_SECRET
ADMIN_PASSWORD=SET_A_STAGING_ONLY_PASSWORD
ADMIN_SETUP_SECRET=GENERATE_A_NEW_STAGING_SECRET

# Mandatory safe default: no calls that can affect real customers or systems.
EXTERNAL_SIDE_EFFECTS=disabled
SMS_PROVIDER=disabled
WHATSAPP_BOT_ENABLED=false

# Keep all real credentials absent in staging:
# MOBIZON_API_KEY=
# FCM_SERVER_KEY=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# STRIPE_SECRET_KEY=sk_test_...

# Optional integrations require separate staging-only resources and an explicit opt-in:
# STAGING_ALLOW_STORAGE=true
# STAGING_CLOUDINARY_CLOUD_NAME=SEPARATE_STAGING_CLOUD
# CLOUDINARY_URL=cloudinary://STAGING_KEY:STAGING_SECRET@SEPARATE_STAGING_CLOUD
# STAGING_ALLOW_GOOGLE_OAUTH=true
# GOOGLE_CLIENT_ID=STAGING_ONLY_CLIENT
# GOOGLE_CLIENT_SECRET=STAGING_ONLY_SECRET
# STAGING_ALLOW_REDIS=true
# REDIS_URL=redis://SEPARATE_STAGING_REDIS
# STAGING_ALLOW_SENTRY=true
# SENTRY_DSN=SEPARATE_STAGING_PROJECT_DSN

# A test-only Telegram bot/chat can be enabled deliberately after isolation is verified:
# STAGING_ALLOW_TELEGRAM=true
# TELEGRAM_BOT_TOKEN=TEST_BOT_ONLY
# TELEGRAM_CHAT_ID=TEST_CHAT_ONLY
