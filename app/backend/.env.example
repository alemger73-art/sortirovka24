# ============================================================
# Sortirovka24 backend — пример переменных окружения
# Скопируйте в .env (в каталоге app/ или app/backend/) и заполните.
# ============================================================

# --- База данных (ОБЯЗАТЕЛЬНО) ---
# Локальная разработка на SQLite (ничего ставить не нужно):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Прод (PostgreSQL / Neon), пример:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Сервер ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
# На Railway для продакшена: ENVIRONMENT=production
# DEBUG=false                 # НИКОГДА true на prod (показывает SMS-коды в API)
# ENTITY_WRITE_PROTECTION=on  # защита /api/v1/entities/* (выключить только для отладки)
# CORS_ALLOWED_ORIGINS=       # через запятую, если SPA на другом домене
# MGX_IGNORE_INIT_DATA=true   # пропустить demo JSON (автоматически в production)

# --- SMS ---
# SMS_PROVIDER=mobizon
# MOBIZON_API_KEY=
# SMS_EXPOSE_CODE=false   # только dev: показывать код на экране всегда

# --- Погода (OpenWeather) ---
# OPENWEATHERMAP_API_KEY=

# --- Масштабирование (опционально) ---
# REDIS_URL=redis://default:password@host:6379

# --- Мониторинг (опционально) ---
# SENTRY_DSN=https://xxx@o000.ingest.sentry.io/000
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Хранилище изображений (Cloudinary) — нужно для загрузки фото ---
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# или по отдельности:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Telegram-уведомления (опционально) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Сообщения о проблемах в приложении (если не задано — используется TELEGRAM_CHAT_ID):
# TELEGRAM_BOT_TOKEN_SUPPORT=
# TELEGRAM_CHAT_ID_SUPPORT=
# Заявки партнёров (Business):
# TELEGRAM_BOT_TOKEN_BUSINESS=
# TELEGRAM_CHAT_ID_BUSINESS=
# Для заказов ГАСТРОНОМ (опционально, иначе используется TELEGRAM_CHAT_ID):
# TELEGRAM_BOT_TOKEN_GASTRONOM=
# TELEGRAM_CHAT_ID_GASTRONOM=
# Для заказов такси (опционально):
# TELEGRAM_BOT_TOKEN_TAXI=
# TELEGRAM_CHAT_ID_TAXI=
# DAM ALEM — операторы (звонок, подтверждение, кнопки в чате):
# TELEGRAM_BOT_TOKEN_FOOD=
# TELEGRAM_CHAT_ID_FOOD=
# DAM ALEM — курьеры (отдельная группа):
# TELEGRAM_BOT_TOKEN_FOOD_COURIER=   # можно тот же бот, что у операторов
# TELEGRAM_CHAT_ID_FOOD_COURIER=
# Webhook для inline-кнопок (зарегистрировать setWebhook на URL /api/v1/telegram/webhook):
# TELEGRAM_WEBHOOK_SECRET=           # secret_token при setWebhook
# PUBLIC_FRONTEND_URL=https://sortirovka24.kz   # ссылка «редактировать заказ» в Telegram

# --- Оплата Stripe (опционально) ---
# STRIPE_SECRET_KEY=
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=

# --- OpenAI (модуль aihub, опционально) ---
# OPENAI_API_KEY=

# --- SMS (Mobizon.kz) — нужно для регистрации ---
# SMS_PROVIDER=mobizon
# MOBIZON_API_KEY=your_api_key_from_mobizon_dashboard
# MOBIZON_API_URL=https://api.mobizon.kz
# MOBIZON_SENDER=          # опционально: подпись отправителя
# SMS_EXPOSE_CODE=true     # показывать код на экране (по умолчанию для Mobizon уже включено)
# SMS_MAX_REQUESTS_PER_WINDOW=6
# SMS_REQUEST_WINDOW_MINUTES=15
# WELCOME_BONUS_POINTS=300
# FOOD_ORDER_BONUS_POINTS=50
# FOOD_ORDER_BONUS_PERCENT=0
# FOOD_BONUS_AWARD_STATUS=done          # начисление после доставки (status=done)
# BONUS_SPENDING_ENABLED=true
# BONUS_TENGE_RATE=1                    # 1 бонус = 1 ₸
# BONUS_MAX_ORDER_PERCENT=30            # максимум % от суммы блюд
# ACCOUNT_SESSION_DAYS=30

# --- Google OAuth (вход/регистрация жителей) ---
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# В Google Cloud Console добавьте redirect URI:
# https://ВАШ-ДОМЕН.up.railway.app/api/v1/account/google/callback

# --- JWT (ОБЯЗАТЕЛЬНО на production — иначе сессии админа сбрасываются при деплое) ---
# JWT_SECRET_KEY=длинная_случайная_строка_64+_символов

# --- Push-уведомления (FCM) — для нативного приложения Android/iOS ---
# 1) Firebase Console → Project settings → Cloud Messaging → Server key (legacy)
# 2) Положите google-services.json в app/frontend/android/app/
# 3) В .env.mobile: VITE_ENABLE_NATIVE_PUSH=true → пересоберите APK
# 4) API: POST /api/v1/push/broadcast (admin JWT) — ручная рассылка
#    Автоматически: push при публикации новости (published=true)
# FCM_SERVER_KEY=AAAA...ваш_ключ...

# --- Админ по умолчанию (опционально) ---
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# ADMIN_SETUP_SECRET=длинный_секрет_для_create-admin_на_проде

# --- Партнёры — отдельные админки /partner/* (email или телефон + пароль) ---
# DAM ALEM: /partner/dam-alem
# DAM_ALEM_PARTNER_EMAIL=  DAM_ALEM_PARTNER_PHONE=  DAM_ALEM_PARTNER_PASSWORD=
# Гастроном: /partner/gastronom
# GASTRONOM_PARTNER_EMAIL=  GASTRONOM_PARTNER_PHONE=  GASTRONOM_PARTNER_PASSWORD=
# VOLNA: /partner/volna
# VOLNA_PARTNER_EMAIL=  VOLNA_PARTNER_PHONE=  VOLNA_PARTNER_PASSWORD=
# PRORAB: /partner/prorab
# PRORAB_PARTNER_EMAIL=  PRORAB_PARTNER_PHONE=  PRORAB_PARTNER_PASSWORD=
# Аптека: /partner/pharmacy
# PHARMACY_PARTNER_EMAIL=  PHARMACY_PARTNER_PHONE=  PHARMACY_PARTNER_PASSWORD=
# *_PARTNER_FORCE_RESET=true — сбросить пароль при деплое

# --- FrontPad (касса DAM ALEM) — только на сервере, не во фронте ---
# Секрет из FrontPad → Настройки → API. Один ключ можно задать как FRONTPAD_SECRET.
# FRONTPAD_MENU_SECRET=   # get_products — синхронизация меню
# FRONTPAD_ORDER_SECRET=  # new_order — отправка заказов (если отличается)
# FRONTPAD_SECRET=        # общий ключ, если один на меню и заказы
# FRONTPAD_AFFILIATE_ID=
# FRONTPAD_DELIVERY_PRODUCT_ID=
# FRONTPAD_AUTO_PUSH_ORDERS=true   # отправлять заказы DAM ALEM в кассу
# FRONTPAD_SYNC_ON_START=true      # синхронизировать меню при первом старте (если каталог пуст)
