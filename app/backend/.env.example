# ============================================================
# Sortirovka24 backend — пример переменных окружения
# Скопируйте в .env (в каталоге app/ или app/backend/) и заполните.
# ============================================================

# --- База данных (ОБЯЗАТЕЛЬНО) ---
# Локальная разработка на SQLite (ничего ставить не нужно):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Прод (PostgreSQL / Neon), пример:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Сервер ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# --- Хранилище изображений (Cloudinary) — нужно для загрузки фото ---
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# или по отдельности:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Telegram-уведомления (опционально) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Оплата Stripe (опционально) ---
# STRIPE_SECRET_KEY=
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=

# --- OpenAI (модуль aihub, опционально) ---
# OPENAI_API_KEY=

# --- SMS (Mobizon.kz) — нужно для регистрации ---
# SMS_PROVIDER=mobizon
# MOBIZON_API_KEY=your_api_key_from_mobizon_dashboard
# MOBIZON_API_URL=https://api.mobizon.kz
# MOBIZON_SENDER=          # опционально: подпись отправителя
# WELCOME_BONUS_POINTS=300
# ACCOUNT_SESSION_DAYS=30

# --- JWT (чтобы не разлогинивало после деплоя) ---
# JWT_SECRET_KEY=длинная_случайная_строка

# --- Админ по умолчанию (опционально) ---
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
