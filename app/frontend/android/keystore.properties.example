# Copy to keystore.properties and fill in after creating a release keystore.
# DO NOT commit keystore.properties or *.jks to git.
#
# Create keystore (one-time):
#   keytool -genkey -v -keystore sortirovka24-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias sortirovka24
#
storeFile=sortirovka24-release.jks
storePassword=your-store-password
keyAlias=sortirovka24
keyPassword=your-key-password
