# Copy to .env.mobile before building the native app (that file is gitignored).
#   cp .env.mobile.example .env.mobile

# Backend API for the mobile app (required)
VITE_API_BASE_URL=https://sortirovka24-production-8788.up.railway.app

# Push notifications — enable only after Firebase is configured:
#   1) google-services.json → app/frontend/android/app/
#   2) FCM_SERVER_KEY on Railway backend
#   3) Rebuild APK
# VITE_ENABLE_NATIVE_PUSH=true

# Live updates: WebView loads UI from Railway instead of bundled files.
# Recommended only after a stable production deploy. Comment out for bundled mode (works offline).
# CAPACITOR_SERVER_URL=https://sortirovka24-production-8788.up.railway.app
