# Copy to .env.mobile before building the native app (that file is gitignored).
#   cp .env.mobile.example .env.mobile

# Backend API for the mobile app (required)
VITE_API_BASE_URL=https://sortirovka24-production-8788.up.railway.app

# Support WhatsApp (digits, for floating button + business form)
VITE_SUPPORT_WHATSAPP=77470304096

# Sentry (optional, production error tracking)
# VITE_SENTRY_DSN=https://xxx@o000.ingest.sentry.io/000

# Push — enable after Firebase (Admin → Push-уведомления for setup steps):
# VITE_ENABLE_NATIVE_PUSH=true

# Live updates: WebView loads UI from Railway instead of bundled files.
# Comment out CAPACITOR_SERVER_URL for bundled mode (works offline, needs APK per UI change).
# For App Store review / first Play release bundled mode is recommended:
#   leave CAPACITOR_SERVER_URL commented — CI ios-release.yml does this automatically.
# CAPACITOR_SERVER_URL=https://sortirovka24-production-8788.up.railway.app
