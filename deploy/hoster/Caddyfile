# Cloudflare stays in front (SSL mode "Full"; "Full (strict)" once the Cloudflare Origin cert is installed). The origin uses a
# Cloudflare Origin Certificate (SSL/TLS -> Origin Server), stored on the server
# as /opt/s24/certs/origin.pem and origin-key.pem (never in git).
{
	auto_https disable_certs
	# Real visitor IP: trust CF-Connecting-IP only when the peer is a Cloudflare edge
	# (https://www.cloudflare.com/ips/). Direct hits are blocked by ufw anyway.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
}

www.sortirovka24.kz, sortirovka24.kz {
	tls /certs/origin.pem /certs/origin-key.pem
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy app:8000 {
		# One trusted value for the app (client-sent X-Forwarded-For is discarded).
		header_up X-Forwarded-For {client_ip}
		health_uri /health
		health_interval 15s
	}
	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}
