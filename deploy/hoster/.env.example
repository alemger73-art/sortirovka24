# Copy to /opt/s24/.env on the server (chmod 600). Values come from Railway variables.
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
CLOUDINARY_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MOBIZON_API_KEY=
SMS_PROVIDER=mobizon
WEB_PUSH_CONTACT=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_PUBLIC_KEY=
FOOD_ORDER_BONUS_POINTS=
WELCOME_BONUS_POINTS=
S24_SCHEMA_VERIFY_ONLY=dam20261006_pwa_preferences
APP_BUILD_ID=
# Integrations enabled at launch
WHATSAPP_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
# Backup target (second server, Kazakhstan)
BACKUP_HOST=
BACKUP_USER=s24backup
BACKUP_KEEP_DAYS=30

# News agent (Karaganda news → Telegram approval → site). Off unless enabled.
NEWS_AGENT_ENABLED=
NEWS_TELEGRAM_BOT_TOKEN=
NEWS_TELEGRAM_CHAT_ID=
# Optional: who may press the buttons (comma-separated Telegram user ids); default = the chat owner
NEWS_TELEGRAM_ADMIN_IDS=
# Optional: AI picks interesting items and retells them in its own words
ANTHROPIC_API_KEY=
# Optional tuning: NEWS_AGENT_PER_RUN=3 NEWS_AGENT_DAILY_MAX=10 NEWS_AGENT_INTERVAL_MINUTES=120 NEWS_AGENT_START_HOUR=8 NEWS_AGENT_END_HOUR=21
