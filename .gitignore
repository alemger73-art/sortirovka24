# ---- Dependencies ----
node_modules/
.pnp/
.pnp.js

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

backups/
app/frontend/dist/
app/frontend/.android-sdk/
app/backend/frontend_dist/
dist/
build/
**/build/
*.tsbuildinfo

# ---- Mobile / Gradle / native build caches ----
# Gradle caches (the main source of the 34k-file bloat). gradle-wrapper.jar is
# intentionally NOT ignored (it must stay in the repo to build).
.gradle/
**/.gradle/
# Custom Gradle user home with the full distribution + docs (~30k files).
.gradle-home/
**/.gradle-home/
*.zip.part
.cxx/
**/.cxx/
local.properties
**/local.properties
# Capacitor copies the built web bundle into the native projects — generated.
app/frontend/android/app/src/main/assets/public/
app/frontend/ios/App/App/public/
app/frontend/ios/App/Pods/
# Release artifacts (regenerated by the build scripts; large binaries).
app/frontend/releases/
*.apk
*.aab
*.ipa
*.keystore

# ---- Test / e2e artifacts ----
test-results/
**/test-results/
playwright-report/
playwright/.cache/

# ---- Logs (runtime) ----
app/backend/logs/*
!app/backend/logs/.gitkeep
*.log
logs/

# ---- Local SQLite / DB ----
*.sqlite
*.sqlite3
*.db

# ---- Env / secrets ----
.env
.env.*
!.env.example
!.env.mobile.example
!.env.*.example
.jwt_secret

# ---- Editor / OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- Misc temp ----
*.tmp
.cache/
